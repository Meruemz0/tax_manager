# Copy to .env and fill in values. Never commit .env.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/tax_db
STORAGE_DIR=/srv/tax-manager/uploads
# Set to 1 when the site is served through HTTPS.
COOKIE_SECURE=0

# Optional on Windows when PostgreSQL is reachable only through an SSH tunnel.
# DATABASE_URL must use the database host and port as seen from the SSH server.
# SSH_HOST=192.0.2.10
# SSH_PORT=22
# SSH_USER=linux_user
# SSH_TARGET_HOST=127.0.0.1
# SSH_LOCAL_PORT=15433
